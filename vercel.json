{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },

    { "src": "/sitemap.xml", "dest": "/frontend/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/frontend/robots.txt" },
    { "src": "/logo.png", "dest": "/frontend/logo.png" },

    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/images/(.*)", "dest": "/frontend/images/$1" },

    { "src": "/products", "dest": "/frontend/pages/products.html" },
    { "src": "/product", "dest": "/frontend/pages/product-detail.html" },
    { "src": "/product-detail", "dest": "/frontend/pages/product-detail.html" },
    { "src": "/cart", "dest": "/frontend/pages/cart.html" },
    { "src": "/checkout", "dest": "/frontend/pages/checkout.html" },
    { "src": "/payment", "dest": "/frontend/pages/payment.html" },
    { "src": "/order-success", "dest": "/frontend/pages/order-success.html" },
    { "src": "/faq", "dest": "/frontend/pages/faq.html" },
    { "src": "/invoice", "dest": "/frontend/pages/invoice.html" },
    { "src": "/update-order", "dest": "/frontend/pages/update-order.html" },
    { "src": "/admin-order-details", "dest": "/frontend/pages/admin-order-details.html" },
    { "src": "/worker-bill", "dest": "/frontend/pages/worker-bill.html" },
    { "src": "/bill", "dest": "/frontend/pages/bill.html" },
    { "src": "/my-orders", "dest": "/frontend/pages/my-orders.html" },
    { "src": "/admin", "dest": "/frontend/pages/admin.html" },
    { "src": "/admin-bulk-enquiries", "dest": "/frontend/pages/admin-bulk-enquiries.html" },
    { "src": "/auth", "dest": "/frontend/pages/auth.html" },

    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "outputDirectory": ".",
  "installCommand": "cd backend && npm install",
  "framework": null
}
